# ===================================================
# PEDRA MANIA - CONFIGURAÇÃO DE AMBIENTE (.env)
# ===================================================

PORT=3000
NODE_ENV=development

# 🐘 BANCO DE DADOS POSTGRESQL
# Exemplo: postgresql://usuario:senha@localhost:5432/pedramania
DATABASE_URL=

# 📍 DADOS DA LOJA DE ORIGEM (VITÓRIA / ES)
STORE_ZIP_CODE=29090460
STORE_ADDRESS=Rua Paschoal Delmaestro, 401
STORE_DISTRICT=Jardim Camburi
STORE_CITY=Vitória
STORE_STATE=ES

# 📦 MELHOR ENVIO (Cálculo de Frete Correios / Jadlog / etc.)
# Para testes utilize 'sandbox' e para loja real utilize 'production'
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_TOKEN=coloque_seu_token_sandbox_aqui

# 🔐 TOKEN DE ACESSO DO PAINEL ADMIN
ADMIN_TOKEN=pedramania_admin_secret_token_2026

# ✉️ CONFIGURAÇÕES DE EMAIL / SMTP (Confirmação de Pedidos & Login OTP)
# Se deixar em branco no modo 'development', o sistema loga os códigos e emails no terminal do servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pedra Mania Armarinho" <contato@pedramania.com.br>
